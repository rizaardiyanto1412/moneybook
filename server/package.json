{
  "name": "moneybook-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "tsx src/node.ts",
    "dev:worker": "wrangler dev -c ../wrangler.toml",
    "deploy": "npm run build:web && wrangler deploy -c ../wrangler.toml",
    "build:web": "esbuild scripts/mmbak.ts --bundle --format=esm --target=es2022 --outfile=../web/js/mmbak.js --banner:js=\"// Generated from server/scripts/mmbak.ts by npm run build:web. Do not edit.\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "private": true
}
